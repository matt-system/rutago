{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "outDir": "dist-types",
    "baseUrl": ".",
    "paths": {
      "@capacitor/core": ["node_modules/@capacitor/core"],
      "@capacitor/core/*": ["node_modules/@capacitor/core/*"]
    }
  },
  "include": ["src"]
}