{
  "expo": {
    "name": "Meshbit",
    "slug": "meshbit",
    "scheme": "meshbit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.meshbit.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Meshbit usa Bluetooth para descubrir dispositivos cercanos y transportar mensajes locales."
      }
    },
    "android": {
      "package": "app.meshbit.mobile",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_ADVERTISE",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#080b0a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}