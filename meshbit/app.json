{
  "expo": {
    "name": "Meshbit",
    "slug": "meshbit",
    "scheme": "meshbit",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.meshbit.mobile"
    },
    "android": {
      "package": "app.meshbit.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#080b0a"
      },
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
